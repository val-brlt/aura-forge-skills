{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Functional scope and delivery metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "items", "releases", "dependencies", "milestones", "public_contracts", "stability_criteria", "stability_approval_ref"],
  "properties": {
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "path", "feature_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["mvp", "change", "legacy"]},
        "path": {"$ref": "#/$defs/text"},
        "feature_refs": {"$ref": "#/$defs/refs"}
      }
    },
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "releases": {"type": "array", "items": {"$ref": "#/$defs/release"}},
    "dependencies": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from_ref", "to_ref", "kind", "reason", "status"],
        "properties": {
          "from_ref": {"$ref": "#/$defs/text"}, "to_ref": {"$ref": "#/$defs/text"},
          "kind": {"enum": ["functional", "ux", "technical"]},
          "reason": {"$ref": "#/$defs/text"}, "status": {"enum": ["confirmed", "proposed"]}
        }
      }
    },
    "milestones": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "criteria", "status", "evidence_refs"],
        "properties": {
          "id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["mvp", "delivery", "other"]},
          "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
          "status": {"enum": ["open", "achieved"]}, "evidence_refs": {"$ref": "#/$defs/refs"}
        }
      }
    },
    "public_contracts": {"$ref": "#/$defs/refs"},
    "stability_criteria": {"$ref": "#/$defs/refs"},
    "stability_approval_ref": {"type": ["string", "null"], "minLength": 1}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "versions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/semver"}},
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "scope", "decision_status", "acceptance_criteria", "planned_versions", "development_status", "delivery_status", "delivered_versions", "evidence_refs"],
      "properties": {
        "ref": {"$ref": "#/$defs/text"}, "scope": {"enum": ["mvp", "future", "supporting"]},
        "decision_status": {"enum": ["approved", "proposed", "rejected", "unresolved"]},
        "acceptance_criteria": {"$ref": "#/$defs/refs"},
        "planned_versions": {"$ref": "#/$defs/versions"},
        "development_status": {"enum": ["unknown", "not_started", "in_progress", "complete"]},
        "delivery_status": {"enum": ["unknown", "not_delivered", "partial", "delivered"]},
        "delivered_versions": {"$ref": "#/$defs/versions"}, "evidence_refs": {"$ref": "#/$defs/refs"}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "baseline_version", "status", "approval_ref", "evidence_refs", "changes"],
      "properties": {
        "version": {"$ref": "#/$defs/semver"},
        "baseline_version": {"anyOf": [{"$ref": "#/$defs/semver"}, {"type": "null"}]},
        "status": {"enum": ["proposed", "planned", "developed", "delivered"]},
        "approval_ref": {"type": ["string", "null"], "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/refs"},
        "changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}}
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "compatibility", "item_refs", "summary", "acceptance_criteria", "depends_on"],
      "properties": {
        "id": {"type": "string", "pattern": "^CHANGE-[A-Za-z0-9._-]+$"},
        "kind": {"enum": ["feature", "fix", "other"]},
        "compatibility": {"enum": ["breaking", "compatible", "unknown"]},
        "item_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "summary": {"$ref": "#/$defs/text"},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "depends_on": {"$ref": "#/$defs/refs"}
      }
    }
  }
}
