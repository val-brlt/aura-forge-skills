{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aura Forge UX contract envelope (nested UX checked by validate_ux_docs.py)",
  "type": "object",
  "required": ["schemaVersion", "version", "status", "scope", "flows", "screens", "featureCoverage", "futureConsiderations"],
  "properties": {
    "schemaVersion": {"type": "integer", "enum": [1, 2]},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "approved"]},
    "scope": {"type": "string", "minLength": 1},
    "flows": {"type": "array", "items": {"type": "object"}},
    "screens": {"type": "array", "items": {"type": "object"}},
    "featureCoverage": {"type": "array", "items": {"type": "object"}},
    "futureConsiderations": {"type": "array", "items": {"type": "object"}},
    "delivery": {"$ref": "../../project-scoping/references/delivery.schema.json"}
  },
  "allOf": [{"if": {"properties": {"schemaVersion": {"const": 2}}}, "then": {"required": ["delivery"]}}]
}
